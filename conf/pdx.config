
/*
========================================================================================
    MODULES
========================================================================================
*/

process {

    withName: '.*:CHECK_REFERENCE_HOST:MAKE_STAR' {
        ext.args = ""
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: 'STAR2Index',
                enabled: params.only_build_index || params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:MAKE_BWA' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: 'BWAIndex',
                enabled: params.only_build_index || params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:GTF2BED' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.bed',
                enabled: params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:GTF2FASTA' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.fa',
                enabled: params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:COLLAPSE_GTF' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.gtf',
                enabled: params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:GTF2GENES' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.txt',
                enabled: params.save_reference
            ]
    }

    withName: '.*:CHECK_REFERENCE_HOST:GTF2TRANSCRIPTS' {
        ext.args = " "
        publishDir = [
                path: { "${params.outdir}/references/${params.genome_host}" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.txt',
                enabled: params.save_reference
            ]
    }

    withName: XENGSORT_CLASSIFY {
        ext.args = " "
        publishDir = [
            [
                path: { "${params.outdir}/${params.xengsort_fq_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*-graft.{1,2}.fq.gz',
                enabled: params.save_classified_fastq
            ],
            [
                path: { "${params.outdir}/${params.xengsort_fq_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*-host.{1,2}.fq.gz',
                enabled: params.save_classified_fastq
            ],
            [
                path: { "${params.outdir}/${params.xengsort_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: '*.xengsort.log',
                enabled: params.workflow == 'pdx'
            ]

        ]   
    }

    withName: '.*:ALIGN_FASTQ:STAR' {
        ext.args = ""
        ext.rg = "CN:FredHutch"
        publishDir = [
            [
                path: { "${params.outdir}/${params.star_dir}/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { fn ->
                fn.startsWith('output') ? null :
                fn.endsWith('bam') ? fn :
                fn.endsWith('bai') ? fn :
                fn.endsWith('Log.final.out') ? null :
                fn.endsWith('versions.yml') ? null :
                "_work/${fn}"
                },
                enabled: params.workflow == 'pdx'
            ],
            [
                path: { "${params.outdir}/${params.star_log_dir}/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { fn -> fn.endsWith('Log.final.out') ? fn : null },
                enabled: params.workflow == 'pdx'
            ]
        ]   
    }

    withName: '.*:ALIGN_FASTQ:STAR_HOST' {
        ext.args = ""
        ext.rg = "CN:FredHutch"
        publishDir = [
            [
                path: { "${params.outdir}/${params.star_host_dir}/"},
                mode: "${params.publish_dir_mode}",
                saveAs: { fn ->
                fn.startsWith('output') ? null :
                fn.endsWith('bam') ? fn :
                fn.endsWith('bai') ? fn :
                fn.endsWith('Log.final.out') ? null :
                fn.endsWith('versions.yml') ? null :
                "_work/${fn}"
                },
                enabled: params.workflow == 'pdx'
            ],
            [
                path: { "${params.outdir}/${params.star_log_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                saveAs: { fn -> fn.endsWith('Log.final.out') ? fn : null },
                enabled: params.workflow == 'pdx'
            ]
        ]   
    }

    withName: '.*:ALIGN_FASTQ:BWA_MEM' {
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/${params.bwa_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: params.workflow == 'pdx'
        ]   
    }

    withName: '.*:ALIGN_FASTQ:BWA_MEM_HOST' {
        publishDir = [
            path: { "${params.outdir}/${params.bwa_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: params.workflow == 'pdx'
        ]   
    }

    withName: '.*:XENOFILTER' {
        publishDir = [
            path: { dir ->
                params.aligner == 'star' ? "${params.outdir}/${params.star_xeno_dir}/" :
                params.aligner == 'bwa-mem' ? "${params.outdir}/${params.bwa_xeno_dir}/" : 
                "${params.outdir}/XenofilteR/${params.genome}/"
                },
            mode: "${params.publish_dir_mode}",
            pattern: "*",
            enabled: !params.split_fastq
        ]   
    }

    withName: '.*:BAM_TO_FASTQ' {
        ext.args = " "
        publishDir = [
            path: { "${params.outdir}/fastq/${params.genome}" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: (params.only_filter_fastq || params.save_filtered_fastq) && params.pdx_tool == 'xenofilter'
        ]   
    }

    withName: '.*:SAMTOOLS_VIEW' {
        publishDir = [
            path: { "${params.outdir}/${params.samtools_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('versions.yml') ? null : fn 
            },
            enabled: params.run_samtools
        ]   
    }

    withName: '.*:SAMTOOLS_VIEW_HOST' {
        publishDir = [
            path: { "${params.outdir}/${params.samtools_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('versions.yml') ? null : fn 
            },
            enabled: params.run_samtools
        ]   
    }

    withName: '.*:SAMTOOLS_VIEW_XENO' {
        publishDir = [
            path: { "${params.outdir}/${params.samtools_xeno_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('versions.yml') ? null : fn 
            },
            enabled: params.run_samtools
        ]   
    }

    withName: RNASEQC_HOST {
        publishDir = [
            path: { "${params.outdir}/${params.rnaseqc_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('versions.yml') ? null : fn 
            },
            enabled: true
        ]   
    }

    withName: RSEQC_HOST {
        publishDir = [
            path: { "${params.outdir}/${params.rseqc_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: "*.{txt,pdf,r,bed,log,xls,xlsx}",
            enabled: true
        ]   
    }

    withName: '.*:QUANT_GENES:GENERATE_GENE_COUNT_MATRIX_HOST' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.gene_expr_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "all_samples.*",
                enabled: params.run_quant_genes && params.run_gene_count
            ]
            
        ]   
    }

    withName: '.*:QUANT_GENES:DIFFERENTIAL_GENES_HOST' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.de_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*_vs_*",
                enabled: params.run_quant_genes && params.run_de && params.comparison
            ],
            [
                path: { "${params.outdir}/${params.de_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.txt",
                enabled: params.run_quant_genes && params.run_de && params.comparison
            ],
            [
                path: { "${params.outdir}/pipeline_info/${params.info_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "comparisons.differential_genes.csv",
                enabled: true
            ],
            [
                path: { "${params.outdir}/${params.de_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "comparisons.differential_genes.csv",
                enabled: params.run_quant_genes && params.run_de && params.comparison
            ]

            
        ]   
    }

    withName: '.*:QUANT_TRANSCRIPTS:SALMON_HOST' {
        publishDir = [
            path: { "${params.outdir}/${params.salmon_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('versions.yml') ? null : fn 
            },
            enabled: true
        ]   
    }

    withName: '.*:QUANT_TRANSCRIPTS:GENERATE_TRANSCRIPT_COUNT_MATRIX_HOST' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.tx_expr_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "all_samples.*",
                enabled: true
            ]
            
        ]   
    }

    withName: '.*:QUANT_TRANSCRIPTS:DIFFERENTIAL_TRANSCRIPTS_HOST' {
        publishDir = [
            [
                path: { "${params.outdir}/${params.dt_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*_vs_*",
                enabled: true
            ],
            [
                path: { "${params.outdir}/${params.dt_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "*.txt",
                enabled: true
            ],
            [
                path: { "${params.outdir}/pipeline_info/${params.info_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "comparisons.differential_transcripts.csv",
                enabled: true
            ],
            [
                path: { "${params.outdir}/${params.dt_host_dir}/" },
                mode: "${params.publish_dir_mode}",
                pattern: "comparisons.differential_transcripts.csv",
                enabled: true
            ]

        ]   
    }

    withName: ARRIBA_HOST {
        publishDir = [
            path: { "${params.outdir}/${params.arriba_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            saveAs: { fn ->
                fn.endsWith('bam') ? fn :
                fn.endsWith('bai') ? fn :
                fn.endsWith('fusions.tsv') ? fn :
                fn.endsWith('versions.yml') ? null :
                fn.endsWith('_STARtmp') ? null :
                "_work/${fn}"
            },
            enabled: true
        ]   
    }

}

