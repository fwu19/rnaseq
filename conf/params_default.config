
/*
* Default params
*/
def run_timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss')
                        .format(new Date())

params {
    // input/output
    input = "$projectDir/assets/dummy_file.csv"
    metadata = "$projectDir/assets/dummy_file.csv"
    input_dir = "$projectDir/assets/dummy_file.csv"
    comparison = null
    workflow = 'regular' // exome,pdx
    
    srcdir = null
    outdir = './Analysis/'
    info_dir = "${params.outdir}/pipeline_info/${run_timestamp}"

    publish_dir_mode = 'copy'
    save_reference = true // save output from processing gtf

    tools = "cutadapt,fastp,fastqc,rnaseqc,rseqc,star,bwa-mem,salmon,arriba" // fastqc,rnaseqc,rseqc,star,bwa-mem,salmon,arriba
    skip_tools = "none"

    // pipeline options
    step = "mapping" // expression_quantification, differential_expression
    update = null
    
    gene_level = true
    transcript_level = false
    gene_fusion = false

    trimmer = 'fastp' // cutadapt,fastp
    save_trimmed_fastq = false
    cat_fastq = true // will cat fastq if multiple fastq per sample
    split_fastq = false
    
    // references
    aligner_index = null // star, bwa // can be multiple separated by comma
    aligner = 'star' // star, bwa-mem
    star = null
    star_host = null
    bwa = null
    bwa_host = null

    genome = 'target_genome'
    genome_fa = null
    gtf = null
    rnaseqc_gtf = null
    rseqc_bed = null
    gene_txt = null
    tx_bed = null
    tx_fa = null
    tx_txt = null

    genome_host = 'host_genome'
    genome_fa_host = null

    // parameters
    split_size = 50000000
    fdr = 0.05
    fc = 1.5
    fdr2 = 0.01
    fc2 = 2
    length_col = "gene_length"
    de_gene_txt = null
    de_gene_type = 'all'

    sjdbOverhang = null
    outSAMattributes = "NH HI NM MD AS XS"
    genomeSAindexNbases = null
    multiqc_config = null

    r1_pattern = "_S[0-9]+(_L[0-9]+)?_R1_" 
    r2_pattern = "_S[0-9]+(_L[0-9]+)?_R2_" 
    adapters = null
}    

