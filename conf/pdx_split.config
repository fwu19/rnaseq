
/*
========================================================================================
    MODULES
========================================================================================
*/

process {
    
    withName: '.*:PDX_XENOFILTER:SPLIT_FASTQ' {
        ext.args = "-s 50000000 -O ./ -f -e .gz "
        publishDir = [
            path: { "${params.outdir}/split_fastq/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*part_*.gz',
            enabled: false
        ]   
    }

    withName: '.*:PDX_XENOFILTER:ALIGN_FASTQ:STAR' {
        ext.args = ""
        ext.rg = "CN:FredHutch"
        publishDir = [
            path: { "${params.outdir}/${params.star_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: false
        ]   
    }

    withName: '.*:PDX_XENOFILTER:ALIGN_FASTQ_HOST:STAR' {
        ext.args = ""
        ext.rg = "CN:FredHutch"
        publishDir = [
            path: { "${params.outdir}/${params.star_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: false
        ]   
    }

    withName: '.*:PDX_XENOFILTER:ALIGN_FASTQ:BWA_MEM' {
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/${params.bwa_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: false
        ]   
    }

    withName: '.*:PDX_XENOFILTER:ALIGN_FASTQ_HOST:BWA_MEM' {
        publishDir = [
            path: { "${params.outdir}/${params.bwa_host_dir}/" },
            mode: "${params.publish_dir_mode}",
            pattern: '*',
            enabled: false
        ]   
    }
    
    withName: '.*:PDX_XENOFILTER:XENOFILTER' {
        publishDir = [
            path: { dir ->
                params.aligner == 'star' ? "${params.outdir}/${params.star_xeno_dir}/" :
                params.aligner == 'bwa-mem' ? "${params.outdir}/${params.bwa_xeno_dir}/" : 
                "${params.outdir}/XenofilteR/${params.genome}/"
                },
            mode: "${params.publish_dir_mode}",
            pattern: "*",
            enabled: !params.run_split_fastq
        ]   
    }

    withName: '.*:PDX_XENOFILTER:MERGE_BAM' {
        ext.suffix = '_Filtered'
        publishDir = [
            path: { dir ->
                params.aligner == 'star' ? "${params.outdir}/${params.star_xeno_dir}/" :
                params.aligner == 'bwa-mem' ? "${params.outdir}/${params.bwa_xeno_dir}/" : 
                "${params.outdir}/XenofilteR/${params.genome}/"
                },
            mode: "${params.publish_dir_mode}",
            pattern: "*",
            enabled: true
        ]   
    }

}

