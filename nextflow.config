

/*
* Default params
*/
def run_timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm')
                        .format(new Date())

params {
    // input/output
    input = null
    metadata = null
    input_dir = null
    comparison = null
    comparison_transcripts = null
    workflow = 'regular' // exome,pdx
    
    srcdir = null
    outdir = 'Analysis/'
    info_dir = "${params.outdir}/pipeline_info/${run_timestamp}"

    publish_dir_mode = 'copy'
    save_reference = true // save output from processing gtf

    skip_tools = null

    // pipeline options
    step = "mapping" // expression_quantification, differential_expression
    update = null
    
    gene_level = true
    transcript_level = false
    gene_fusion = false

    trimmer = 'fastp' // cutadapt,fastp
    save_trimmed_fastq = false
    cat_fastq = true // will cat fastq if multiple fastq per sample
    split_fastq = false
    
    // references
    aligner_index = null // star, bwa // can be multiple separated by comma
    aligner = 'star' // star, bwa-mem
    star = null
    star_host = null
    bwa = null
    bwa_host = null

    genome = 'target_genome'
    genome_fa = null
    gtf = null
    rnaseqc_gtf = null
    rseqc_bed = null
    gene_txt = null
    tx_bed = null
    tx_fa = null
    tx_txt = null

    genome_host = 'host_genome'
    genome_fa_host = null

    // parameters
    r1_pattern = "_S[0-9]+(_L[0-9]+)?_R1_" 
    r2_pattern = "_S[0-9]+(_L[0-9]+)?_R2_" 
    adapters = null
    split_size = 50000000

    sjdb_overhang = null
    out_sam_attributes = "NH HI NM MD AS XS"
    genome_sa_index_bases = null
    
    multiqc_config = null

    fdr = 0.05
    fc = 1.5
    fdr2 = 0.01
    fc2 = 2
    length_col = "gene_length"
    de_gene_txt = null
    de_gene_type = 'all'

    report_dir = null
    report_rmd = null
}    


// Load base.config by default for all pipelines
includeConfig "conf/base.config"

// Load flowswitch.config
includeConfig "conf/flowswitch.config"

// Load modules.config for DSL2 module specific options
includeConfig "conf/modules.config"

if (params.workflow == 'pdx' ){
    includeConfig "conf/pdx.config"
    if (params.run_split_fastq){
        includeConfig "conf/pdx_split.config"
    }
}

includeConfig "conf/profiles.config"

/*
*
*/
// Capture exit codes from upstream processes when piping
process.shell = ["/bin/bash", "-euo", "pipefail"]

timeline {
    enabled = true
    file    = "${params.info_dir}/execution_timeline.html"
    file    = "${params.info_dir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.info_dir}/execution_report.html"
    file    = "${params.info_dir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.info_dir}/execution_trace.txt" 
    file    = "${params.info_dir}/execution_trace.txt" 
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.info_dir}/pipeline_dag.html" 
    file    = "${params.info_dir}/pipeline_dag.html" 
    overwrite = true
}

