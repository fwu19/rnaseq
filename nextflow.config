

/*
* Default params
*/
def run_timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm')
                        .format(new Date())

params {
    // input/output
    input = null
    metadata = null
    input_dir = null
    comparison = null
    comparison_transcripts = params.comparison
    workflow = 'regular' // exome,pdx
    
    srcdir = null
    outdir = 'Analysis/'
    info_dir = "${run_timestamp}"

    publish_dir_mode = 'copy'
    save_reference = true // save output from processing gtf

    skip_tools = null

    // pipeline options
    step = "mapping" // expression_quantification, differential_expression
    update = null
    
    gene_level = true
    transcript_level = false
    gene_fusion = false

    trimmer = 'fastp' // cutadapt,fastp
    save_trimmed_fastq = false
    cat_fastq = true // will cat fastq if multiple fastq per sample
    split_fastq = false
    
    // references
    aligner_index = null // star, bwa-mem // can be multiple separated by comma // tools to build indices for
    aligner = 'star' // star, bwa-mem
    star = null
    star_host = null
    bwa = null
    bwa_host = null

    genome = 'target_genome'
    genome_fa = null
    gtf = null
    rnaseqc_gtf = null
    rseqc_bed = null
    gene_txt = null
    tx_bed = null
    tx_fa = null
    tx_txt = null

    genome_host = 'host_genome'
    genome_fa_host = null

    // parameters
    r1_pattern = "_S[0-9]+(_L[0-9]+)?_R1_" 
    r2_pattern = "_S[0-9]+(_L[0-9]+)?_R2_" 
    adapters = null
    split_size = 50000000

    sjdb_overhang = null
    out_sam_attributes = "NH HI NM MD AS XS"
    genome_sa_index_bases = null
    
    multiqc_config = null

    de_method = "QL" // LRT
    fdr = 0.05
    fc = 1.5
    fdr2 = 0.01
    fc2 = 2
    length_col = "gene_length"
    de_gene_txt = params.gene_txt
    de_gene_type = 'all'

    report_dir = null
    report_rmd = "${projectDir}/assets/report/rnaseq_${params.workflow}.Rmd"
    report_html = params.workflow == 'exome' ? "00_RNAexome_analysis_report.html" : (params.workflow == 'pdx' ? "00_PDX_RNAseq_analysis_report.html" : "00_RNAseq_analysis_report.html")

    // output subdirectories
    star_dir = params.workflow == 'pdx' ? "STAR/${params.genome}/_unfiltered/" : "STAR/${params.genome}/"
    star_host_dir = "STAR/${params.genome_host}/_unfiltered/"
    star_xeno_dir = "STAR/${params.genome}/_filtered/"
    bwa_dir = params.workflow == 'pdx' ? "BWA-MEM/${params.genome}/_unfiltered/" : "BWA/${params.genome}/"
    bwa_host_dir = "BWA-MEM/${params.genome_host}/_unfiltered/"
    bwa_xeno_dir = "BWA-MEM/${params.genome}/_filtered/"
    featurecounts_dir = "featureCounts/${params.genome}/"
    salmon_dir = "salmon/${params.genome}/"
    arriba_dir = "arriba/${params.genome}/"
    fastqc_dir = "QC/fastqc/"
    fastqc_trimmed_dir = "QC/fastqc_trimmed/"
    cutadapt_dir = "QC/cutadapt/"
    fastp_dir = "QC/fastp/"
    star_log_dir = params.workflow == 'pdx' ? "QC/star/${params.genome}/_unfiltered" : "QC/star/"
    star_log_host_dir = "QC/star/${params.genome_host}/_unfiltered/"
    rnaseqc_dir = "QC/rnaseqc/"
    rseqc_dir = "QC/rseqc/"
    gatk_dir = "QC/gatk/"
    samtools_dir = params.workflow == 'pdx' ? "QC/samtools/${params.genome}/_unfiltered" : "QC/samtools/"
    samtools_host_dir = "QC/samtools/${params.genome_host}/_unfiltered/"
    samtools_xeno_dir = "QC/samtools/${params.genome}/_filtered/"
    multiqc_dir = "multiqc/"
    gene_expr_dir = "expression_quantification/"
    tx_expr_dir = "expression_quantification/"
    de_dir = "differential_genes/"
    dt_dir = "differential_transcripts/"
}    


// Load base.config by default for all pipelines
includeConfig "conf/base.config"

// Load flowswitch.config
includeConfig "conf/flowswitch.config"

// Load modules.config for DSL2 module specific options
includeConfig "conf/modules.config"

if (params.workflow == 'pdx' ){
    includeConfig "conf/pdx.config"
    if (params.run_split_fastq){
        includeConfig "conf/pdx_split.config"
    }
}

includeConfig "conf/profiles.config"

/*
*
*/
// Capture exit codes from upstream processes when piping
process.shell = ["/bin/bash", "-euo", "pipefail"]

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_timeline.html"
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_report.html"
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_trace.txt" 
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_trace.txt" 
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/pipeline_dag.html" 
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/pipeline_dag.html" 
    overwrite = true
}

