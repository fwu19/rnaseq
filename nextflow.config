

/*
* Default params
*/
def run_timestamp = new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm')
                        .format(new Date())

params {
    // input/output
    input = null
    metadata = null
    input_dir = null
    comparison = null
    comparison_transcripts = params.comparison
    workflow = 'regular' // exome,pdx
    
    srcdir = null
    outdir = 'Analysis/'
    info_dir = "${run_timestamp}"

    publish_dir_mode = 'copy'
    save_reference = true // publish built references

    skip_tools = null

    // pipeline options
    step = "mapping" // expression_quantification, differential_expression
    update = null
    
    gene_level = true
    transcript_level = false
    gene_fusion = false

    trimmer = 'trimgalore' // trimgalore,cutadapt,fastp
    save_trimmed_fastq = false
    cat_fastq = true // will cat fastq if multiple fastq per sample
    split_fastq = false
    save_filtered_fastq = false // save xenofilteR filtered fastq
    save_classified_fastq = false // save xengsort classified fastq
    
    // references
    reference_index = null // aligners to build indices for, multiple tools separated by comma, accepted values are star, bwa-mem, xengsort 
    aligner = 'star' // only a single value is allowed, accepted values are star, bwa-mem

    genome = 'target_genome'
    genome_fa = null
    gtf = null
    star = null
    bwa = null
    rnaseqc_gtf = null
    rseqc_bed = null
    gene_txt = null
    tx_bed = null
    tx_fa = null
    tx_txt = null

    genome_host = 'host_genome'
    genome_fa_host = null
    gtf_host = null
    star_host = null
    bwa_host = null
    rnaseqc_gtf_host = null
    rseqc_bed_host = null
    gene_txt_host = null
    tx_bed_host = null
    tx_fa_host = null
    tx_txt_host = null

    pdx_tool = 'xengsort' //xengsort, xenofilteR, xenofilter
    xengsort = null
    
    // parameters
    r1_pattern = "_S[0-9]+(_L[0-9]+)?_R1_" 
    r2_pattern = "_S[0-9]+(_L[0-9]+)?_R2_" 
    fastq_ext = '[.](fastq|fq)([.]gz)?$'
    adapters = null
    split_size = 50000000

    sjdb_overhang = null
    out_sam_attributes = "NH HI NM MD AS XS"
    genome_sa_index_bases = null
    
    multiqc_config = null

    de_method = "QL" // LRT
    fdr = 0.05
    fc = 1.5
    fdr2 = 0.01
    fc2 = 2
    length_col = "gene_length"
    de_gene_txt = params.gene_txt
    de_gene_txt_host = params.gene_txt_host
    de_gene_type = 'all'

    report_dir = null
    report_rmd = null
    report_html = params.workflow == 'exome' ? "00_RNAexome_analysis_report.html" : (params.workflow == 'pdx' ? "00_PDX_RNAseq_analysis_report.html" : "00_RNAseq_analysis_report.html")

    // output subdirectories
    xengsort_fq_dir = "fastq/${params.genome}"
    xengsort_fq_host_dir = "fastq/${params.genome_host}"

    star_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "${params.genome}/STAR/_unfiltered" : "${params.genome}/STAR") : "STAR"
    star_host_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "${params.genome_host}/STAR/_unfiltered" : "${params.genome_host}/STAR" ) : "STAR"
    star_xeno_dir = "${params.genome}/STAR/_filtered" // only for xenofilteR

    bwa_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "${params.genome}/BWA-MEM/_unfiltered" : "${params.genome}/BWA-MEM") : "BWA-MEM"
    bwa_host_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "${params.genome_host}/BWA-MEM/_unfiltered" : "${params.genome_host}/BWA-MEM") : "BWA-MEM" 
    bwa_xeno_dir = "${params.genome}/BWA-MEM/_filtered"

    featurecounts_dir = "${params.genome}/featureCounts"
    featurecounts_host_dir = "${params.genome_host}/featureCounts"

    salmon_dir = params.workflow == 'pdx' ? "${params.genome}/salmon" : "salmon"
    salmon_host_dir = "${params.genome_host}/salmon"

    arriba_dir = params.workflow == 'pdx' ? "${params.genome}/arriba" : "arriba"
    arriba_host_dir = "${params.genome_host}/arriba"

    fastqc_dir = "QC/fastqc"
    fastqc_trimmed_dir = "QC/fastqc_trimmed"
    cutadapt_dir = "QC/cutadapt"
    trimgalore_dir = "QC/trimgalore"
    fastp_dir = "QC/fastp"

    xengsort_dir = "QC/xengsort"

    star_log_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "QC/star/${params.genome}/_unfiltered" : "QC/star/${params.genome}" ) : "QC/star"
    star_log_host_dir = params.workflow == 'pdx' && params.pdx_tool == 'xenofilter' ? "QC/star/${params.genome_host}/_unfiltered" : "QC/star/${params.genome_host}" 

    rnaseqc_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "QC/rnaseqc/${params.genome}/_filtered" : "QC/rnaseqc/${params.genome}") : "QC/rnaseqc"
    rnaseqc_host_dir = "QC/rnaseqc/${params.genome_host}"

    rseqc_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "QC/rseqc/${params.genome}/_filtered" : "QC/rseqc/${params.genome}") : "QC/rseqc"
    rseqc_host_dir = "QC/rseqc/${params.genome_host}"

    gatk_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "QC/gatk/${params.genome}/_filtered" : "QC/gatk/${params.genome}") : "QC/gatk"
    gatk_host_dir = "QC/gatk/${params.genome_host}"

    samtools_dir = params.workflow == 'pdx' ? (params.pdx_tool == 'xenofilter' ? "QC/samtools/${params.genome}/_unfiltered" : "QC/samtools/${params.genome}/") : "QC/samtools"
    samtools_host_dir = params.workflow == 'pdx' && params.pdx_tool == 'xenofilter' ? "QC/samtools/${params.genome_host}/_unfiltered" : "QC/samtools/${params.genome_host}"
    samtools_xeno_dir = "QC/samtools/${params.genome}/_filtered"

    multiqc_dir = "multiqc"

    gene_expr_dir = params.workflow == 'pdx' ? "${params.genome}/expression_quantification" : "expression_quantification"
    gene_expr_host_dir = "${params.genome_host}/expression_quantification"

    tx_expr_dir = params.workflow == 'pdx' ? "${params.genome}/expression_quantification" : "expression_quantification"
    tx_expr_host_dir = "${params.genome_host}/expression_quantification"

    de_dir = params.workflow == 'pdx' ? "${params.genome}/differential_genes" : "differential_genes"
    de_host_dir = "${params.genome_host}/differential_genes"

    dt_dir = params.workflow == 'pdx' ? "${params.genome}/differential_transcripts" : "differential_transcripts"
    dt_host_dir = "${params.genome_host}/differential_transcripts"

}    


// Load base.config by default for all pipelines
includeConfig "conf/base.config"

// Load flowswitch.config
includeConfig "conf/flowswitch.config"

// Load modules.config for DSL2 module specific options
includeConfig "conf/modules.config"

if (params.workflow == 'pdx' ){
    includeConfig "conf/pdx.config"
    if (params.run_split_fastq){
        includeConfig "conf/pdx_split.config"
    }
}

includeConfig "conf/profiles.config"

/*
*
*/
// Capture exit codes from upstream processes when piping
process.shell = ["/bin/bash", "-euo", "pipefail"]

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_timeline.html"
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_report.html"
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_trace.txt" 
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/execution_trace.txt" 
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/pipeline_dag.html" 
    file    = "${params.outdir}/pipeline_info/${params.info_dir}/pipeline_dag.html" 
    overwrite = true
}

